    {
      "kind": "review",
      "createdAt": 1793982000000,
      "review": {
        "albumId": "s-e1",
        "userId": "u-jonas",
        "authorName": "Jonas",
        "hasAvatar": false,
        "rating": 10,
        "body": "The first time I heard this I did not know what to make of it. The guitars are mostly gone, the vocals are cut up and buried, and the opening track sounds like a broken keyboard. Twenty years later it is the record I come back to most. Everything in Its Right Place still sounds like the future. How to Disappear Completely is the saddest thing they ever made, and Idioteque is the closest a rock band has come to a dance floor in a panic. Play it loud, at night, from start to finish. The silence before Motion Picture Soundtrack ends the record better than any song could. If you only know OK Computer, start here next.",
        "createdAt": 1793982000000,
        "updatedAt": 1793982000000,
        "ups": 27,
        "downs": 2,
        "score": 25,
        "myVote": 0,
        "authorDeleted": false,
