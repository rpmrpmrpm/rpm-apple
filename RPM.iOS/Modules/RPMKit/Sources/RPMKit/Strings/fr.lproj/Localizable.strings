/* Description of the Bloom visualizer, shown on its gallery card. */
"Viz_BloomDesc" = "Une fleur de lumière sur une spirale d'or. Le tour de la roue est la fréquence, l'éloignement du cœur est le temps : chaque temps s'ouvre au centre et voyage vers les pétales.";

/* Name of the Chladni visualizer, after the physicist Ernst Chladni. A proper name. */
"Viz_ChladniName" = "Chladni";

/* Description of the Chladni visualizer, shown on its gallery card. */
"Viz_ChladniDesc" = "Du sable sur une plaque que l'on fait sonner, comme Chladni en 1787. Les grains fuient là où la plaque vibre et se posent sur les lignes immobiles : la figure est la musique elle-même. Dans le silence, le sable s'arrête.";

/* Name of the Butterfly visualizer: the spectrum mirrored into four. */
"Viz_ButterflyName" = "Papillon";

/* Description of the Butterfly visualizer, shown on its gallery card. */
"Viz_ButterflyDesc" = "Le spectre, en miroir sur quatre quadrants. Les graves au centre, les aigus vers les bords. Le niveau de chaque bande trace une ligne sombre d'où la lumière s'ouvre : les bandes fortes rayonnent largement, les faibles se referment en un trait.";

/* Name of the Tunnel visualizer: a folded tunnel flown to the beat. */
"Viz_TunnelName" = "Tunnel";

/* Description of the Tunnel visualizer, shown on its gallery card. */
"Viz_TunnelDesc" = "Un tunnel de lumière repliée, parcouru au rythme du morceau. La caméra coupe toutes les deux mesures et les parois changent de forme à chaque phrase : le montage suit le disque, pas une horloge. Les pistes analysées le pilotent avec leur propre grille rythmique.";

/* Name of the Kaleidoscope visualizer: space reflected between two mirrors. */
"Viz_KaleidoscopeName" = "Kaléidoscope";

/* Description of the Kaleidoscope visualizer, shown on its gallery card. */
"Viz_KaleidoscopeDesc" = "Deux miroirs disposés en angle, avec une seule barre entre eux. Quatre réflexions successives forment une rosace, et le morceau règle l'angle : le motif se répète un nombre de fois différent à chaque phrase.";

/* Name of the Lattice visualizer: a three-dimensional slice through a four-dimensional grid. */
"Viz_LatticeName" = "Réseau";

/* Description of the Lattice visualizer, shown on its gallery card. */
"Viz_LatticeDesc" = "Une coupe dans une grille à quatre dimensions au lieu de trois. Rien ne bouge dans la grille : c'est le rythme qui déplace la coupe, si bien que les cellules surgissent, s'ouvrent et se referment, et chaque phrase fait pivoter la grille dans une direction sans équivalent ici.";
