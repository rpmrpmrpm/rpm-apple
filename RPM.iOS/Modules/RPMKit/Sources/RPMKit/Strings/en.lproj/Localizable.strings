/* Tooltip of the same button while those words are shown as written, so the next press masks them. Applies to every track played, whatever the file's own advisory flag says. */
"Viz_CensorOn" = "Hide explicit words";

/* Name of the Low Frequency Flow visualizer (a proper name, left untranslated). */
"Viz_LowFlowName" = "Low Frequency Flow";

/* Description of the Low Frequency Flow visualizer, shown on its gallery card. */
"Viz_LowFlowDesc" = "A flight through a field of turning blocks, lit by the track. The spectrum sets them alight and the camera re-frames itself every few bars.";

/* Name of the Bloom visualizer: a polar spectrogram drawn as a flower. */
"Viz_BloomName" = "Bloom";

/* Description of the Bloom visualizer, shown on its gallery card. */
"Viz_BloomDesc" = "A flower of light on a golden spiral. Around the wheel is frequency, outward from the heart is time, so every beat opens at the centre and travels out through the petals.";

/* Name of the Chladni visualizer, after the physicist Ernst Chladni. A proper name. */
"Viz_ChladniName" = "Chladni";

/* Description of the Chladni visualizer, shown on its gallery card. */
"Viz_ChladniDesc" = "Sand on a sounding plate, as Chladni did it in 1787. The grains flee wherever the plate moves and settle on the lines where it stands still, so the figure is the music itself. In silence the sand simply stops.";

/* Name of the Butterfly visualizer: the spectrum mirrored into four. */
"Viz_ButterflyName" = "Butterfly";

/* Description of the Butterfly visualizer, shown on its gallery card. */
"Viz_ButterflyDesc" = "The spectrum, mirrored into four. Bass sits in the middle and treble runs out to the edges. Each band's level draws a dark line with the light opening away from it, so loud bands glow wide and quiet ones close to a seam.";

/* Name of the Tunnel visualizer: a folded tunnel flown to the beat. */
"Viz_TunnelName" = "Tunnel";

/* Description of the Tunnel visualizer, shown on its gallery card. */
"Viz_TunnelDesc" = "A tunnel of folded light, flown to the beat. The camera cuts every two bars and the walls change shape on the phrase, so the edit follows the record instead of a clock. Analysed tracks drive it from their own beat grid.";

/* Name of the Kaleidoscope visualizer: space reflected between two mirrors. */
"Viz_KaleidoscopeName" = "Kaleidoscope";

/* Description of the Kaleidoscope visualizer, shown on its gallery card. */
"Viz_KaleidoscopeDesc" = "Two mirrors, set at an angle, with a single strut between them. Reflecting it four times over builds a rose window, and the record sets the angle: the pattern comes round a different number of times on every phrase.";

/* Name of the Lattice visualizer: a three-dimensional slice through a four-dimensional grid. */
"Viz_LatticeName" = "Lattice";

/* Description of the Lattice visualizer, shown on its gallery card. */
"Viz_LatticeDesc" = "A slice through a grid that has four dimensions instead of three. Nothing in the grid moves. The beat moves the slice, so cells swell out of nothing, open and close again, and every phrase turns the grid in a direction that has no equivalent here.";
