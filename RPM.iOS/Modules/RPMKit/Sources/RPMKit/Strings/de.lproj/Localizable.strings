/* Description of the Bloom visualizer, shown on its gallery card. */
"Viz_BloomDesc" = "Eine Blüte aus Licht auf einer goldenen Spirale. Der Umlauf ist die Frequenz, der Weg vom Herzen nach außen die Zeit: Jeder Schlag öffnet sich in der Mitte und wandert durch die Blätter.";

/* Name of the Chladni visualizer, after the physicist Ernst Chladni. A proper name. */
"Viz_ChladniName" = "Chladni";

/* Description of the Chladni visualizer, shown on its gallery card. */
"Viz_ChladniDesc" = "Sand auf einer klingenden Platte, wie es Chladni 1787 tat. Die Körner fliehen dort, wo die Platte schwingt, und sammeln sich auf den ruhenden Linien: Die Figur ist die Musik selbst. In der Stille bleibt der Sand einfach liegen.";

/* Name of the Butterfly visualizer: the spectrum mirrored into four. */
"Viz_ButterflyName" = "Schmetterling";

/* Description of the Butterfly visualizer, shown on its gallery card. */
"Viz_ButterflyDesc" = "Das Spektrum, vierfach gespiegelt. Bass in der Mitte, Höhen nach außen. Der Pegel jedes Bandes zeichnet eine dunkle Linie, von der aus sich das Licht öffnet: laute Bänder leuchten breit, leise schließen sich zu einem Strich.";

/* Name of the Tunnel visualizer: a folded tunnel flown to the beat. */
"Viz_TunnelName" = "Tunnel";

/* Description of the Tunnel visualizer, shown on its gallery card. */
"Viz_TunnelDesc" = "Ein Tunnel aus gefaltetem Licht, im Takt durchflogen. Die Kamera schneidet alle zwei Takte, und die Wände ändern ihre Form mit der Phrase: Der Schnitt folgt dem Titel und nicht einer Uhr. Analysierte Titel steuern ihn über ihr eigenes Beatraster.";

/* Name of the Kaleidoscope visualizer: space reflected between two mirrors. */
"Viz_KaleidoscopeName" = "Kaleidoskop";

/* Description of the Kaleidoscope visualizer, shown on its gallery card. */
"Viz_KaleidoscopeDesc" = "Zwei Spiegel im Winkel zueinander, dazwischen eine einzige Strebe. Viermal gespiegelt entsteht daraus eine Fensterrose, und der Titel bestimmt den Winkel: Das Muster wiederholt sich in jeder Phrase unterschiedlich oft.";

/* Name of the Lattice visualizer: a three-dimensional slice through a four-dimensional grid. */
"Viz_LatticeName" = "Gitter";

/* Description of the Lattice visualizer, shown on its gallery card. */
"Viz_LatticeDesc" = "Ein Schnitt durch ein Gitter mit vier statt drei Dimensionen. Im Gitter bewegt sich nichts: Der Takt bewegt den Schnitt, sodass Zellen aus dem Nichts anschwellen, sich öffnen und wieder schließen, und jede Phrase dreht das Gitter in eine Richtung, die es hier nicht gibt.";
