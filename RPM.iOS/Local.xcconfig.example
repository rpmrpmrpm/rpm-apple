// Copy this file to Local.xcconfig and fill in your own values. Find your team id in Xcode under
// Settings > Accounts, or at developer.apple.com > Membership. A free Apple ID works.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.example.rpm

// The App Group the app shares with its home screen widget. The widget's bundle id is the app's
// with ".widget" after it.
RPM_APP_GROUP = group.com.example.rpm

// Your developer key from rpmrpmrpm.com/developer. Optional: without it, pages that need the API stay empty.
RPM_APP_KEY = YOUR_DEVELOPER_KEY
